<%- include('../partials/top', { title, activePage }) %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h5 class="mb-1">Transfer Stok (Penerimaan dari Pusat)</h5>
    <small class="text-muted">Riwayat stok barang yang dikirim langsung dari Gudang KL (Pusat) ke Cabang Ketapang</small>
  </div>
  <div class="d-flex align-items-center gap-2">
    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
      <i class="bi bi-check-circle me-1"></i> Terhubung ke Gudang KL
    </span>
    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="location.reload()" title="Muat ulang halaman">
      <i class="bi bi-arrow-clockwise me-1"></i> Muat Ulang
    </button>
  </div>
</div>

<!-- Info Banner -->
<div class="alert alert-info border-info-subtle bg-info-subtle text-body d-flex align-items-center mb-4 py-2 px-3 small">
  <i class="bi bi-info-circle-fill text-info me-2 fs-5"></i>
  <div>
    <strong>Informasi Alur Stok:</strong> Pengiriman stok diproses langsung oleh admin Gudang KL (Pusat). Setiap barang yang dikirim akan otomatis tercatat di halaman ini dan stok toko bertambah langsung tanpa perlu input manual.
  </div>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-md-4">
    <div class="card p-3 border shadow-sm h-100">
      <div class="text-muted small">Total Penerimaan</div>
      <div class="fw-bold fs-4 text-primary"><%= incomingList.length %> Pengiriman</div>
      <div class="small text-muted mt-1">Riwayat kiriman dari Gudang KL</div>
    </div>
  </div>
  <div class="col-sm-6 col-md-4">
    <div class="card p-3 border shadow-sm h-100">
      <div class="text-muted small">Total Barang Diterima</div>
      <div class="fw-bold fs-4 text-success">
        <%= incomingList.reduce(function(acc, t) { return acc + (t.total_qty || 0); }, 0) %> Pcs
      </div>
      <div class="small text-muted mt-1">Total fisik stok masuk ke cabang ini</div>
    </div>
  </div>
  <div class="col-sm-12 col-md-4">
    <div class="card p-3 border shadow-sm h-100">
      <div class="text-muted small">Pengiriman Terakhir</div>
      <div class="fw-bold fs-4 text-body">
        <% if (incomingList && incomingList.length > 0) { %>
          <%= incomingList[0].total_qty %> Pcs
        <% } else { %>
          <span class="text-muted fs-5">Belum Ada</span>
        <% } %>
      </div>
      <div class="small text-muted mt-1">
        <% if (incomingList && incomingList.length > 0) { %>
          Diterima tgl <%= incomingList[0].tanggal %> (<%= incomingList[0].time %>)
        <% } else { %>
          Menunggu kiriman baru dari Gudang KL
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Incoming Transfers Table -->
<div class="card shadow-sm border">
  <div class="card-header bg-transparent fw-bold py-3 d-flex justify-content-between align-items-center">
    <span><i class="bi bi-inbox me-2 text-primary"></i>Riwayat Penerimaan Stok dari Gudang KL</span>
    <span class="badge bg-primary"><%= incomingList.length %> Kiriman</span>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light small text-uppercase">
          <tr>
            <th style="width: 5%;">#</th>
            <th style="width: 18%;">Tanggal & Waktu</th>
            <th style="width: 18%;">Asal Kiriman</th>
            <th style="width: 32%;">Daftar Barang Diterima</th>
            <th style="width: 12%; text-align: center;">Total Jumlah</th>
            <th style="width: 15%;">Status Stok</th>
          </tr>
        </thead>
        <tbody class="small">
          <% if (!incomingList || incomingList.length === 0) { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="bi bi-box-seam d-block mb-2 text-secondary opacity-50" style="font-size: 2.5rem;"></i>
                <div class="fw-semibold">Belum ada riwayat penerimaan stok dari Pusat</div>
                <div class="small text-muted mt-1">Saat admin Gudang KL mengirimkan stok ke cabang ini, rincian barang otomatis tercatat dan stok bertambah.</div>
              </td>
            </tr>
          <% } else { %>
            <% incomingList.forEach(function(item, idx) { %>
              <tr>
                <td class="text-muted"><%= idx + 1 %></td>
                <td>
                  <div class="fw-semibold"><%= item.tanggal %></div>
                  <div class="small text-muted font-monospace"><%= item.time %></div>
                </td>
                <td>
                  <span class="badge bg-secondary-subtle text-secondary border">
                    <i class="bi bi-building me-1"></i><%= item.source || 'Gudang KL' %>
                  </span>
                  <% if (item.notes) { %>
                    <div class="small text-muted fst-italic mt-1"><i class="bi bi-chat-left-text me-1"></i>"<%= item.notes %>"</div>
                  <% } %>
                </td>
                <td>
                  <ul class="list-unstyled mb-0 ps-1">
                    <% (item.items || []).forEach(function(sub) { %>
                      <li class="py-1 border-bottom border-light-subtle d-flex justify-content-between align-items-center">
                        <span><strong><%= sub.nama_barang %></strong></span>
                        <span class="badge bg-light text-dark border ms-2">+<%= sub.qty %> Pcs</span>
                      </li>
                    <% }); %>
                  </ul>
                </td>
                <td class="text-center fw-bold text-success fs-6">
                  <%= item.total_qty %> Pcs
                </td>
                <td>
                  <span class="badge bg-success-subtle text-success border border-success-subtle">
                    <i class="bi bi-check-circle me-1"></i>Stok Bertambah
                  </span>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/bottom') %>
