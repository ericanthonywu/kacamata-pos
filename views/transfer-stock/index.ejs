<%- include('../partials/top', { title, activePage }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="mb-1">Transfer Stok (Penerimaan dari Pusat)</h5>
    <small class="text-muted">Riwayat stok barang yang dikirim dan ditransfer langsung dari Pusat (kacamata-pos-pusat)</small>
  </div>
  <div class="d-flex align-items-center gap-2">
    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
      <i class="bi bi-broadcast me-1"></i> API Penerimaan Siap
    </span>
    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="location.reload()" title="Muat ulang">
      <i class="bi bi-arrow-clockwise me-1"></i> Refresh
    </button>
  </div>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-md-4">
    <div class="card p-3 border shadow-sm">
      <div class="text-muted small">Total Penerimaan</div>
      <div class="fw-bold fs-4 text-primary"><%= incomingList.length %> Transaksi</div>
      <div class="small text-muted mt-1">Batch pengiriman dari pusat</div>
    </div>
  </div>
  <div class="col-sm-6 col-md-4">
    <div class="card p-3 border shadow-sm">
      <div class="text-muted small">Total Unit Diterima</div>
      <div class="fw-bold fs-4 text-success">
        <%= incomingList.reduce(function(acc, t) { return acc + (t.total_qty || 0); }, 0) %> Pcs
      </div>
      <div class="small text-muted mt-1">Total stok masuk ke cabang</div>
    </div>
  </div>
  <div class="col-sm-12 col-md-4">
    <div class="card p-3 border shadow-sm">
      <div class="text-muted small">Arah & Host Pusat</div>
      <div class="fw-bold fs-5 text-body">Pusat &rarr; Cabang</div>
      <div class="small text-muted mt-1">Host: <code><%= (pusatConfig && pusatConfig.host) || 'http://localhost:9090' %></code></div>
    </div>
  </div>
</div>

<!-- Incoming Transfers Table -->
<div class="card shadow-sm border">
  <div class="card-header bg-transparent fw-bold py-3 d-flex justify-content-between align-items-center">
    <span><i class="bi bi-inbox me-2 text-primary"></i>Riwayat Penerimaan Stok dari Pusat</span>
    <span class="badge bg-primary"><%= incomingList.length %> Data</span>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light small text-uppercase">
          <tr>
            <th style="width: 5%;">#</th>
            <th style="width: 18%;">Waktu & Tanggal</th>
            <th style="width: 15%;">Pengirim</th>
            <th style="width: 35%;">Rincian Barang</th>
            <th style="width: 12%; text-align: center;">Total Qty</th>
            <th style="width: 15%;">Status</th>
          </tr>
        </thead>
        <tbody class="small">
          <% if (!incomingList || incomingList.length === 0) { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="bi bi-box-arrow-in-down d-block mb-2 text-secondary opacity-50" style="font-size: 2.5rem;"></i>
                <div class="fw-semibold">Belum ada riwayat transfer stok masuk dari Pusat</div>
                <div class="small text-muted mt-1">Ketika admin Pusat melakukan transfer stok ke cabang ini, rincian barang otomatis tercatat dan stok bertambah.</div>
              </td>
            </tr>
          <% } else { %>
            <% incomingList.forEach(function(item, idx) { %>
              <tr>
                <td class="text-muted"><%= idx + 1 %></td>
                <td>
                  <div class="fw-semibold"><%= item.tanggal %></div>
                  <div class="small text-muted font-monospace"><%= item.time %></div>
                </td>
                <td>
                  <span class="badge bg-secondary-subtle text-secondary border">
                    <i class="bi bi-building me-1"></i><%= item.source || 'Pusat' %>
                  </span>
                  <% if (item.notes) { %>
                    <div class="small text-muted fst-italic mt-1">"<%= item.notes %>"</div>
                  <% } %>
                </td>
                <td>
                  <ul class="list-unstyled mb-0 ps-1">
                    <% (item.items || []).forEach(function(sub) { %>
                      <li class="py-1 border-bottom border-light-subtle d-flex justify-content-between">
                        <span><strong><%= sub.nama_barang %></strong></span>
                        <span class="badge bg-light text-dark border ms-2">+<%= sub.qty %> Pcs</span>
                      </li>
                    <% }); %>
                  </ul>
                </td>
                <td class="text-center fw-bold text-success fs-6">
                  <%= item.total_qty %> Pcs
                </td>
                <td>
                  <span class="badge bg-success-subtle text-success border border-success-subtle">
                    <i class="bi bi-check-circle me-1"></i>Diterima & Ditambahkan
                  </span>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/bottom') %>
