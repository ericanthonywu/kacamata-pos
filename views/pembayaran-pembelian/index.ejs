<%
function fmtRp(v) { return 'Rp ' + Number(v||0).toLocaleString('id-ID'); }
function fmtDate(d) { return d ? new Date(d).toLocaleDateString('id-ID') : '-'; }
%>
<%- include('../partials/top', { title, activePage }) %>

<div class="row g-3">
  <!-- LEFT: Unpaid list -->
  <div class="col-md-5">
    <div class="card p-3">
      <h6 class="mb-3">📋 Daftar Hutang Pembelian</h6>
      <% if (unpaid.length === 0) { %>
        <div class="text-center text-muted py-3"><i class="bi bi-check-circle text-success" style="font-size:2rem"></i><div class="mt-2">Tidak ada hutang</div></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-sm table-hover mb-0">
            <thead><tr><th>Kode</th><th>Supplier</th><th>Total</th><th>Dibayar</th><th>Sisa</th><th></th></tr></thead>
            <tbody>
              <% unpaid.forEach(function(p) { var sisa = p.total_harga - p.total_dibayar; %>
              <tr class="<%= selectedPembelian && selectedPembelian.id == p.id ? 'table-active' : '' %>">
                <td class="font-monospace small"><%= p.kode_pembelian %></td>
                <td><%= p.supplier_nama || '-' %></td>
                <td><%= fmtRp(p.total_harga) %></td>
                <td class="text-success"><%= fmtRp(p.total_dibayar) %></td>
                <td class="text-danger fw-bold"><%= fmtRp(sisa) %></td>
                <td><a href="/pembayaran-pembelian?pembelian_id=<%= p.id %>" class="btn btn-sm btn-outline-success"><i class="bi bi-wallet2"></i></a></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- RIGHT: Payment form + history -->
  <div class="col-md-7">
    <% if (selectedPembelian) { %>
      <div class="card p-3 mb-3">
        <h6>💰 Bayar: <span class="text-info font-monospace"><%= selectedPembelian.kode_pembelian %></span></h6>
        <table class="table table-sm mb-3">
          <tr><td class="text-muted">Supplier</td><td><%= selectedPembelian.supplier_nama || '-' %></td></tr>
          <tr><td class="text-muted">Total</td><td class="fw-bold"><%= fmtRp(selectedPembelian.total_harga) %></td></tr>
          <% var totalDibayar = payments.reduce(function(s,p){ return s + parseFloat(p.jumlah_bayar||0); }, 0); %>
          <tr><td class="text-muted">Sudah Dibayar</td><td class="text-success"><%= fmtRp(totalDibayar) %></td></tr>
          <tr><td class="text-muted">Sisa Hutang</td><td class="text-danger fw-bold"><%= fmtRp(selectedPembelian.total_harga - totalDibayar) %></td></tr>
        </table>
        <div class="row g-2">
          <div class="col-4">
            <label class="form-label small">Tanggal</label>
            <input type="date" class="form-control form-control-sm" id="tanggal_bayar" value="<%= new Date().toISOString().slice(0,10) %>">
          </div>
          <div class="col-4">
            <label class="form-label small">Jumlah Bayar</label>
            <input type="number" class="form-control form-control-sm" id="jumlah_bayar" value="<%= selectedPembelian.total_harga - totalDibayar %>" min="1">
          </div>
          <div class="col-4">
            <label class="form-label small">Keterangan</label>
            <input type="text" class="form-control form-control-sm" id="keterangan" placeholder="Opsional">
          </div>
        </div>
        <button class="btn btn-success btn-sm mt-3" onclick="bayar()"><i class="bi bi-check-lg"></i> Bayar</button>
      </div>

      <% if (payments.length > 0) { %>
      <div class="card p-3">
        <h6>📜 Riwayat Pembayaran</h6>
        <table class="table table-sm mb-0">
          <thead><tr><th>Tanggal</th><th>Jumlah</th><th>Keterangan</th><th></th></tr></thead>
          <tbody>
            <% payments.forEach(function(p) { %>
            <tr>
              <td><%= fmtDate(p.tanggal_bayar) %></td>
              <td class="text-success fw-bold"><%= fmtRp(p.jumlah_bayar) %></td>
              <td class="small"><%= p.keterangan || '-' %></td>
              <td><button class="btn btn-sm btn-outline-danger" onclick="hapusBayar(<%= p.id %>)"><i class="bi bi-trash"></i></button></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>
    <% } else { %>
      <div class="card p-3 text-center text-muted py-5">
        <i class="bi bi-arrow-left" style="font-size:2rem"></i>
        <div class="mt-2">Pilih pembelian dari daftar untuk melakukan pembayaran</div>
      </div>
    <% } %>
  </div>
</div>

<script>
function bayar() {
  var payload = {
    pembelian_id: <%= selectedPembelian ? selectedPembelian.id : 'null' %>,
    tanggal_bayar: $('#tanggal_bayar').val(),
    jumlah_bayar: parseFloat($('#jumlah_bayar').val()) || 0,
    keterangan: $('#keterangan').val(),
  };
  if (payload.jumlah_bayar <= 0) { showToast('Jumlah bayar harus > 0', 'danger'); return; }
  $.ajax({ url: '/pembayaran-pembelian', method: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
    success: function() { location.reload(); },
    error: function(xhr) { showToast(xhr.responseJSON?.message || 'Gagal', 'danger'); }
  });
}

function hapusBayar(id) {
  if (!confirm('Hapus pembayaran ini?')) return;
  $.ajax({ url: '/pembayaran-pembelian/' + id, method: 'DELETE',
    success: function() { location.reload(); },
    error: function(xhr) { showToast(xhr.responseJSON?.message || 'Gagal', 'danger'); }
  });
}
</script>

<%- include('../partials/bottom') %>
