<%
function fmtRp(v) { return 'Rp ' + Number(v||0).toLocaleString('id-ID'); }
function fmtDate(d) { return d ? new Date(d).toLocaleDateString('id-ID') : '-'; }
%>
<%- include('../partials/top', { title, activePage }) %>

<div class="row g-3 mb-3">
  <div class="col-md-4">
    <div class="stat-card">
      <i class="bi bi-exclamation-triangle stat-icon text-danger"></i>
      <div class="stat-value"><%= unpaid.length %></div>
      <div class="stat-label">Pembelian Belum Lunas</div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card">
      <i class="bi bi-cash-stack stat-icon text-warning"></i>
      <div class="stat-value"><%= fmtRp(unpaid.reduce(function(s,p){ return s + (parseFloat(p.total_harga) - parseFloat(p.total_dibayar)); }, 0)) %></div>
      <div class="stat-label">Total Sisa Hutang</div>
    </div>
  </div>
</div>

<div class="card p-3">
  <% if (unpaid.length === 0) { %>
    <div class="text-center text-muted py-5">
      <i class="bi bi-check-circle text-success" style="font-size:3rem"></i>
      <h5 class="mt-3">Tidak ada hutang pembelian</h5>
    </div>
  <% } else { %>
  <table id="tblHutangBeli" class="table table-hover mb-0" style="width:100%">
    <thead><tr><th>Kode</th><th>Tanggal</th><th>Supplier</th><th>Total</th><th>Dibayar</th><th>Sisa</th><th style="width:100px">Aksi</th></tr></thead>
    <tbody>
      <% unpaid.forEach(function(p) { var sisa = p.total_harga - p.total_dibayar; %>
      <tr>
        <td class="font-monospace text-info"><%= p.kode_pembelian %></td>
        <td><%= fmtDate(p.tanggal_pembelian) %></td>
        <td><%= p.supplier_nama || '-' %></td>
        <td><%= fmtRp(p.total_harga) %></td>
        <td class="text-success"><%= fmtRp(p.total_dibayar) %></td>
        <td class="text-danger fw-bold"><%= fmtRp(sisa) %></td>
        <td>
          <a href="/pembayaran-pembelian/bayar/<%= p.id %>" class="btn btn-sm btn-success"><i class="bi bi-wallet2"></i> Bayar</a>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>
</div>

<script>
$(function() { $('#tblHutangBeli').DataTable({ order: [], language: dtLanguageID }); });
</script>

<%- include('../partials/bottom') %>
