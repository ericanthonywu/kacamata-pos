<%
function fmtRp(v) { return 'Rp ' + Number(v||0).toLocaleString('id-ID'); }
%>
<%- include('./partials/top', { title, activePage }) %>

<div class="mb-4">
  <h3 class="fw-bold">Selamat Datang, <%= currentUser?.nama %> 👋</h3>
  <p class="text-muted">Panel admin OPTIK SENTRAL — kelola data toko Anda.</p>
</div>

<% if (currentUser.hak_akses === 'admin' && (hutangPembelian.length > 0 || hutangPenjualan.length > 0)) { %>
<div class="row g-3 mb-4">
  <% if (hutangPembelian.length > 0) { %>
  <div class="col-md-6">
    <div class="card border-danger p-3">
      <div class="d-flex align-items-center mb-2">
        <i class="bi bi-exclamation-triangle text-danger me-2" style="font-size:1.5rem"></i>
        <h6 class="mb-0 text-danger">Hutang Pembelian (Supplier)</h6>
      </div>
      <p class="mb-2"><strong><%= hutangPembelian.length %></strong> pembelian belum lunas — total sisa: <strong class="text-danger"><%= fmtRp(totalHutangPembelian) %></strong></p>
      <a href="/pembayaran-pembelian" class="btn btn-outline-danger btn-sm"><i class="bi bi-wallet2"></i> Lihat & Bayar</a>
    </div>
  </div>
  <% } %>
  <% if (hutangPenjualan.length > 0) { %>
  <div class="col-md-6">
    <div class="card border-warning p-3">
      <div class="d-flex align-items-center mb-2">
        <i class="bi bi-clock-history text-warning me-2" style="font-size:1.5rem"></i>
        <h6 class="mb-0 text-warning">Hutang Penjualan (DP Pelanggan)</h6>
      </div>
      <p class="mb-2"><strong><%= hutangPenjualan.length %></strong> penjualan DP belum lunas — total sisa: <strong class="text-warning"><%= fmtRp(totalHutangPenjualan) %></strong></p>
      <a href="/pembayaran-penjualan" class="btn btn-outline-warning btn-sm"><i class="bi bi-wallet2"></i> Lihat & Bayar</a>
    </div>
  </div>
  <% } %>
</div>
<% } %>

<div class="row g-3 mb-4 row-cols-2 row-cols-md-5">
  <div class="col">
    <div class="stat-card"><i class="bi bi-receipt stat-icon text-info"></i><div class="stat-value"><%= lifetimeSummary.total_transaksi || 0 %></div><div class="stat-label">Total Transaksi</div></div>
  </div>
  <div class="col">
    <div class="stat-card"><i class="bi bi-shield-plus stat-icon text-secondary"></i><div class="stat-value"><%= fmtRp(lifetimeSummary.total_bpjs) %></div><div class="stat-label">Total BPJS</div></div>
  </div>
  <% if (currentUser.hak_akses === 'admin') { %>
  <div class="col">
    <div class="stat-card"><i class="bi bi-cash stat-icon text-primary"></i><div class="stat-value"><%= fmtRp(lifetimeSummary.total_subtotal) %></div><div class="stat-label">Total Subtotal</div></div>
  </div>
  <div class="col">
    <div class="stat-card"><i class="bi bi-wallet2 stat-icon text-warning"></i><div class="stat-value"><%= fmtRp(lifetimeSummary.total_dp_belum_lunas) %></div><div class="stat-label">Total DP (Belum Lunas)</div></div>
  </div>
  <div class="col">
    <div class="stat-card"><i class="bi bi-graph-up stat-icon text-success"></i><div class="stat-value"><%= fmtRp(lifetimeSummary.total_penjualan) %></div><div class="stat-label">Total Penjualan Bersih</div></div>
  </div>
  <% } %>
</div>

<div class="row g-3">
  <div class="col-md-3 col-6">
    <div class="stat-card">
      <i class="bi bi-receipt stat-icon text-info"></i>
      <div class="stat-label">Data Penjualan</div>
      <a href="/penjualan" class="stretched-link"></a>
    </div>
  </div>
  <div class="col-md-3 col-6">
    <div class="stat-card">
      <i class="bi bi-plus-square stat-icon text-success"></i>
      <div class="stat-label">Tambah Penjualan</div>
      <a href="/penjualan/baru" class="stretched-link"></a>
    </div>
  </div>
  <div class="col-md-3 col-6">
    <div class="stat-card">
      <i class="bi bi-cart-plus stat-icon text-primary"></i>
      <div class="stat-label">Pembelian</div>
      <a href="/pembelian" class="stretched-link"></a>
    </div>
  </div>
  <div class="col-md-3 col-6">
    <div class="stat-card">
      <i class="bi bi-box-seam stat-icon text-success"></i>
      <div class="stat-label">Barang</div>
      <a href="/barang" class="stretched-link"></a>
    </div>
  </div>
  <div class="col-md-3 col-6">
    <div class="stat-card">
      <i class="bi bi-graph-up stat-icon text-warning"></i>
      <div class="stat-label">Laporan Kas</div>
      <a href="/laporan/kas" class="stretched-link"></a>
    </div>
  </div>
</div>

<%- include('./partials/bottom') %>
