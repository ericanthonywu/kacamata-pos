<%- include('../partials/top', { title, activePage }) %>

<div class="row g-3 mb-4">
  <div class="col-md-4 col-6">
    <div class="stat-card"><i class="bi bi-box-seam stat-icon text-info"></i><div class="stat-value"><%= data.length %></div><div class="stat-label">Jenis Barang</div></div>
  </div>
  <div class="col-md-4 col-6">
    <div class="stat-card"><i class="bi bi-house-gear stat-icon text-success"></i><div class="stat-value"><%= data.reduce(function(s,d){ return s + (d.qty||0); }, 0) %></div><div class="stat-label">Total Unit</div></div>
  </div>
  <div class="col-md-4 col-6">
    <div class="stat-card"><i class="bi bi-exclamation-triangle stat-icon text-warning"></i><div class="stat-value"><%= data.filter(function(d){ return d.qty <= 5; }).length %></div><div class="stat-label">Stock Rendah (≤5)</div></div>
  </div>
</div>

<div class="card p-3">
  <table id="tblStock" class="table table-hover mb-0" style="width:100%">
    <thead><tr><th>Nama Barang</th><th>Kategori</th><th>Barcode</th><th>Qty</th><th>Status</th></tr></thead>
    <tbody>
      <% data.forEach(function(item) { %>
      <tr>
        <td><%= item.nama_barang %></td>
        <td><span class="badge bg-info bg-opacity-25 text-info"><%= item.kategori_nama || '-' %></span></td>
        <td class="font-monospace small"><%= item.barcode_id || '-' %></td>
        <td class="fw-bold <%= item.qty <= 0 ? 'text-danger' : item.qty <= 5 ? 'text-warning' : '' %>"><%= item.qty %></td>
        <td>
          <% if (item.qty <= 0) { %>
            <span class="badge bg-danger">Habis</span>
          <% } else if (item.qty <= 5) { %>
            <span class="badge bg-warning text-dark">Rendah</span>
          <% } else { %>
            <span class="badge bg-success">Tersedia</span>
          <% } %>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<script>
$(function() { $('#tblStock').DataTable({ order: [[3, 'asc']], language: { url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/id.json' } }); });
</script>

<%- include('../partials/bottom') %>
