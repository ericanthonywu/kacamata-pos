<% function fmtDate(d) { return d ? new Date(d).toLocaleDateString('id-ID', { day: '2-digit' , month: '2-digit' ,
  year: 'numeric' , hour: '2-digit' , minute: '2-digit' }) : '-' ; } %>
  <%- include('../partials/top', { title, activePage }) %>
    <%- include('../partials/select2') %>

      <div class="row g-2 mb-3 align-items-end">
        <div class="col-auto">
          <label class="form-label small">Dari</label>
          <input type="date" id="filterFrom" class="form-control form-control-sm" value="<%= filters.from || '' %>">
        </div>
        <div class="col-auto">
          <label class="form-label small">Sampai</label>
          <input type="date" id="filterTo" class="form-control form-control-sm" value="<%= filters.to || '' %>">
        </div>
        <div class="col-auto">
          <button type="button" class="btn btn-primary btn-sm" id="btnFilter"><i class="bi bi-search"></i>
            Tampilkan</button>
          <button type="button" class="btn btn-outline-danger btn-sm" id="btnReset"><i class="bi bi-x-circle"></i>
            Reset</button>
        </div>
        <div class="col-auto ms-auto">
          <button class="btn btn-primary btn-sm" id="btnAdd"><i class="bi bi-plus"></i> Tambah</button>
        </div>
      </div>

      <div class="card p-3">
        <table id="tblBhf" class="table table-hover mb-0" style="width:100%">
          <thead>
            <tr>
              <th>Nama Barang</th>
              <th>Barcode</th>
              <th>Qty Sebelum</th>
              <th>Qty Sesudah</th>
              <th>Selisih</th>
              <th>Diubah Oleh</th>
              <th>Tanggal</th>
              <th style="width:80px">Aksi</th>
            </tr>
          </thead>
          <tbody>
          </tbody>
        </table>
      </div>

      <!-- Form Modal -->
      <div class="modal fade" id="formModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">Tambah Bukti Hitung Fisik</h5><button type="button" class="btn-close"
                data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
              <div class="mb-3">
                <label class="form-label small">Barang</label>
                <select class="form-select" id="barang_id" style="width:100%"></select>
              </div>
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label small">Qty Sebelum (Stock Saat Ini)</label>
                  <input type="text" class="form-control" id="qty_sebelum" readonly>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label small">Qty Sesudah</label>
                  <input type="number" class="form-control" id="qty_sesudah" placeholder="Masukan qty baru">
                </div>
              </div>
              <div id="selisih-preview" style="display:none;">
                <div class="alert alert-info py-2 mb-0">
                  <small>Selisih: <strong id="selisih-value">0</strong></small>
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
              <button class="btn btn-primary btn-sm" id="btnSave">Simpan</button>
            </div>
          </div>
        </div>
      </div>

      <script>
        window.userRole = '<%= currentUser.hak_akses %>';
        $(function () {
          function newExportAction(e, dt, button, config) {
            var self = this;
            var oldStart = dt.settings()[0]._iDisplayStart;
            dt.one('preXhr', function (e, s, data) {
              data.start = 0;
              data.length = -1;
              dt.one('preDraw', function (e, settings) {
                if (button[0].className.indexOf('buttons-excel') >= 0) {
                  $.fn.dataTable.ext.buttons.excelHtml5.available(dt, config) ?
                    $.fn.dataTable.ext.buttons.excelHtml5.action.call(self, e, dt, button, config) : null;
                } else if (button[0].className.indexOf('buttons-csv') >= 0) {
                  $.fn.dataTable.ext.buttons.csvHtml5.available(dt, config) ?
                    $.fn.dataTable.ext.buttons.csvHtml5.action.call(self, e, dt, button, config) : null;
                }
                dt.one('preXhr', function (e, s, data) {
                  settings._iDisplayStart = oldStart;
                  data.start = oldStart;
                });
                setTimeout(dt.ajax.reload, 0);
                return false;
              });
            });
            dt.ajax.reload();
          }

          var dt = $('#tblBhf').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
              url: '/bukti-hitung-fisik/dt',
              data: function (d) {
                d.from = $('#filterFrom').val();
                d.to = $('#filterTo').val();
              }
            },
            order: [[6, 'desc']],
            lengthMenu: [[10, 50, 100, -1], [10, 50, 100, "All"]],
            layout: {
              topStart: {
                pageLength: {},
                buttons: {}
              },
              topEnd: 'search',
              bottomStart: 'info',
              bottomEnd: 'paging'
            },
            buttons: [
              {
                extend: 'excelHtml5',
                text: '<i class="bi bi-file-earmark-excel"></i> Excel',
                className: 'btn btn-success btn-sm',
                action: newExportAction,
                exportOptions: { columns: ':visible:not(:last-child)', orthogonal: 'export' }
              },
              {
                extend: 'csvHtml5',
                text: '<i class="bi bi-filetype-csv"></i> CSV',
                className: 'btn btn-info btn-sm',
                action: newExportAction,
                exportOptions: { columns: ':visible:not(:last-child)', orthogonal: 'export' }
              },
              {
                extend: 'print',
                text: '<i class="bi bi-printer"></i> Print',
                className: 'btn btn-secondary btn-sm',
                exportOptions: { columns: ':visible:not(:last-child)', orthogonal: 'export' }
              }
            ],
            language: dtLanguageID,
            columns: [
              {
                data: 'nama_barang',
                render: function (d, type, row) {
                  if (type !== 'display' && type !== 'filter') return d;
                  var sph = row.sph_r || row.sph_l || '';
                  var cyl = row.cyl_r || row.cyl_l || '';
                  var add = row.add_r || row.add_l || '';
                  var ukuran = '';
                  if (sph || cyl || add) {
                    ukuran = ' <span class="text-muted small">(SPH: ' + sph + ' CYL: ' + cyl + (add ? ' ADD: ' + add : '') + ')</span>';
                  }
                  return d + ukuran;
                }
              },
              { data: 'barcode_id', render: function (d) { return '<span class="font-monospace small">' + (d || '-') + '</span>'; } },
              { data: 'qty_sebelum' },
              { data: 'qty_sesudah' },
              {
                data: 'selisih', render: function (d) {
                  if (d > 0) return '<span class="text-success fw-bold">+' + d + '</span>';
                  if (d < 0) return '<span class="text-danger fw-bold">' + d + '</span>';
                  return '<span class="text-muted">0</span>';
                }
              },
              { data: 'diubah_oleh' },
              {
                data: 'created_at', render: function (d) {
                  if (!d) return '-';
                  var dt = new Date(d);
                  var dd = String(dt.getDate()).padStart(2, '0');
                  var mm = String(dt.getMonth() + 1).padStart(2, '0');
                  var yy = dt.getFullYear();
                  var hh = String(dt.getHours()).padStart(2, '0');
                  var mi = String(dt.getMinutes()).padStart(2, '0');
                  return dd + '/' + mm + '/' + yy + ' ' + hh + ':' + mi;
                }
              },
              {
                data: 'id', orderable: false, render: function (d) {
                  if (window.userRole === 'admin') {
                    return '<button class="btn btn-sm btn-outline-danger btn-del" data-id="' + d + '" data-url="/bukti-hitung-fisik/' + d + '"><i class="bi bi-trash"></i></button>';
                  }
                  return '';
                }
              }
            ]
          });

          // Filter
          $('#btnFilter').on('click', function () { dt.ajax.reload(); });
          $('#btnReset').on('click', function () {
            $('#filterFrom').val('');
            $('#filterTo').val('');
            dt.ajax.reload();
          });



          // Delete
          $(document).on('click', '.btn-del', function () {
            confirmDelete($(this).data('id'), $(this).data('url'));
          });

          // Form modal
          var formModal = new bootstrap.Modal(document.getElementById('formModal'));

          // Init Select2 AJAX for barang
          $('#barang_id').select2({
            theme: 'bootstrap-5',
            placeholder: '-- Cari Barang --',
            allowClear: true,
            dropdownParent: $('#formModal'),
            ajax: {
              url: '/barang/search',
              dataType: 'json',
              delay: 250,
              data: function (params) {
                return { q: params.term || '' };
              },
              processResults: function (data) {
                return {
                  results: $.map(data.data, function (item) {
                    var text = item.nama_barang;
                    var sph = item.sph_r || item.sph_l || '';
                    var cyl = item.cyl_r || item.cyl_l || '';
                    var add = item.add_r || item.add_l || '';
                    if (sph || cyl || add) {
                      text += ' (SPH: ' + sph + ' CYL: ' + cyl + ' ADD: ' + add + ')';
                    }
                    text += ' [Stok: ' + (item.qty !== null ? item.qty : '-') + ']';
                    return { id: item.id, text: text, item: item };
                  })
                };
              },
              cache: true
            }
          }).on('select2:select', function (e) {
            var b = e.params.data.item;
            $('#qty_sebelum').val(b.qty !== null ? b.qty : 0);
            $('#qty_sesudah').val('');
            $('#selisih-preview').hide();
          }).on('select2:clear', function () {
            $('#qty_sebelum').val('');
            $('#qty_sesudah').val('');
            $('#selisih-preview').hide();
          });

          $('#btnAdd').on('click', function () {
            // Reset form
            $('#barang_id').val(null).trigger('change');
            $('#qty_sebelum').val('');
            $('#qty_sesudah').val('');
            $('#selisih-preview').hide();
            formModal.show();
          });

          // Preview selisih
          $('#qty_sesudah').on('input', function () {
            var sebelum = parseInt($('#qty_sebelum').val()) || 0;
            var sesudah = parseInt($(this).val());
            if (!isNaN(sesudah)) {
              var selisih = sesudah - sebelum;
              var text = selisih > 0 ? '+' + selisih : String(selisih);
              var cls = selisih > 0 ? 'text-success' : (selisih < 0 ? 'text-danger' : 'text-muted');
              $('#selisih-value').text(text).attr('class', cls);
              $('#selisih-preview').show();
            } else {
              $('#selisih-preview').hide();
            }
          });

          // Save
          $('#btnSave').on('click', function () {
            var btn = this;
            if (!setBtnLoading(btn)) return;

            var barangId = $('#barang_id').val();
            var qtySesudah = $('#qty_sesudah').val();

            if (!barangId) {
              showToast('Pilih barang terlebih dahulu', 'warning');
              resetBtn(btn);
              return;
            }
            if (qtySesudah === '' || isNaN(parseInt(qtySesudah))) {
              showToast('Qty sesudah harus diisi', 'warning');
              resetBtn(btn);
              return;
            }

            $.ajax({
              url: '/bukti-hitung-fisik',
              method: 'POST',
              contentType: 'application/json',
              data: JSON.stringify({ barang_id: barangId, qty_sesudah: qtySesudah }),
              success: function (res) {
                if (res.success) {
                  formModal.hide();
                  showToast('Bukti hitung fisik berhasil ditambahkan', 'success');
                  dt.ajax.reload();
                }
                resetBtn(btn);
              },
              error: function (xhr) {
                showToast((xhr.responseJSON && xhr.responseJSON.message) || 'Gagal menyimpan', 'danger');
                resetBtn(btn);
              }
            });
          });
        });
      </script>

      <%- include('../partials/bottom') %>