<%
function fmtRp(v) { return 'Rp ' + Number(v||0).toLocaleString('id-ID'); }
function fmtDate(d) { return d ? new Date(d).toLocaleDateString('id-ID') : '-'; }
%>
<%- include('../partials/top', { title, activePage }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div></div>
  <a href="/penjualan/baru" class="btn btn-primary btn-sm"><i class="bi bi-plus"></i> Penjualan Baru</a>
</div>

<div class="card p-3">
  <table id="tblPenjualan" class="table table-hover mb-0" style="width:100%">
    <thead><tr><th>No. Nota</th><th>Tanggal</th><th>Pelanggan</th><th>Sales</th><th>Total</th><th>Status</th><th style="width:150px">Aksi</th></tr></thead>
    <tbody>
      <% data.forEach(function(item) { %>
      <tr>
        <td class="font-monospace text-info"><%= item.no_nota %></td>
        <td><%= fmtDate(item.order_date) %></td>
        <td><%= item.pelanggan_nama || '-' %></td>
        <td><%= item.sales_nama || '-' %></td>
        <td class="fw-bold"><%= fmtRp(item.total) %></td>
        <td>
          <% if (item.status_bayar === 'lunas') { %>
            <span class="badge bg-success">✅ Lunas</span>
          <% } else if (item.status_bayar === 'dp') { %>
            <a href="/pembayaran-penjualan/bayar/<%= item.id %>" class="badge bg-warning text-dark text-decoration-none">⏳ DP</a>
          <% } else { %>
            <a href="/pembayaran-penjualan/bayar/<%= item.id %>" class="badge bg-danger text-decoration-none">❌ Belum Lunas</a>
          <% } %>
        </td>
        <td>
          <button class="btn btn-sm btn-outline-info me-1" onclick="printNota(<%= item.id %>)"><i class="bi bi-printer"></i></button>
          <% if (item.status_bayar !== 'lunas') { %>
          <a href="/pembayaran-penjualan/bayar/<%= item.id %>" class="btn btn-sm btn-outline-success me-1" title="Bayar"><i class="bi bi-wallet2"></i></a>
          <% } %>
          <a href="/penjualan-retur/baru?penjualan_id=<%= item.id %>" class="btn btn-sm btn-outline-warning" title="Retur"><i class="bi bi-arrow-return-left"></i></a>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>



<script>
$(function() {
  $('#tblPenjualan').DataTable({
    order: [],
    language: dtLanguageID
  });
});

function printNota(id) {
  $.get('/penjualan/' + id, function(res) {
    if (res.success) printNotaData(res.data);
  });
}

function fmtRp(v) { return 'Rp ' + Number(v||0).toLocaleString('id-ID'); }


</script>

<%- include('../partials/bottom') %>
