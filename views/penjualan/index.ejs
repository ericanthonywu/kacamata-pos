<%
function fmtRp(v) { return 'Rp ' + Number(v||0).toLocaleString('id-ID'); }
function fmtDate(d) { return d ? new Date(d).toLocaleDateString('id-ID') : '-'; }
%>
<%- include('../partials/top', { title, activePage }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div></div>
  <a href="/penjualan/baru" class="btn btn-primary btn-sm"><i class="bi bi-plus"></i> Penjualan Baru</a>
</div>

<div class="card p-3">
  <table id="tblPenjualan" class="table table-hover mb-0" style="width:100%">
    <thead><tr><th>No. Nota</th><th>Tanggal</th><th>Pelanggan</th><th>Sales</th><th>Total</th><th style="width:150px">Aksi</th></tr></thead>
    <tbody>
      <% data.forEach(function(item) { %>
      <tr>
        <td class="font-monospace text-info"><%= item.no_nota %></td>
        <td><%= fmtDate(item.order_date) %></td>
        <td><%= item.pelanggan_nama || '-' %></td>
        <td><%= item.sales_nama || '-' %></td>
        <td class="fw-bold"><%= fmtRp(item.total) %></td>
        <td>
          <button class="btn btn-sm btn-outline-info me-1" onclick="printNota(<%= item.id %>)"><i class="bi bi-printer"></i> Nota</button>
          <button class="btn btn-sm btn-outline-danger" onclick="confirmVoid(<%= item.id %>)"><i class="bi bi-x-circle"></i></button>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- Void Modal -->
<div class="modal fade" id="voidModal" tabindex="-1">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body text-center py-4">
        <i class="bi bi-exclamation-triangle text-warning" style="font-size:2.5rem"></i>
        <h5 class="mt-3">Batalkan Penjualan?</h5>
        <p class="text-muted small">Stok barang akan dikembalikan.</p>
      </div>
      <div class="modal-footer justify-content-center border-0 pt-0">
        <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Kembali</button>
        <button class="btn btn-danger btn-sm" id="voidBtn">Ya, Batalkan</button>
      </div>
    </div>
  </div>
</div>

<script>
$(function() {
  $('#tblPenjualan').DataTable({
    order: [],
    language: { url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/id.json' }
  });
});

function printNota(id) {
  $.get('/penjualan/' + id, function(res) {
    if (!res.success) return;
    var d = res.data;
    var lines = [];
    lines.push('================================');
    lines.push('         KACAMATA POS');
    lines.push('================================');
    lines.push('No Nota : ' + d.no_nota);
    lines.push('Tanggal : ' + new Date(d.order_date).toLocaleDateString('id-ID'));
    if (d.pelanggan_nama) lines.push('Customer: ' + d.pelanggan_nama);
    if (d.sales_nama) lines.push('Sales   : ' + d.sales_nama);
    lines.push('--------------------------------');
    (d.detail||[]).forEach(function(item) {
      var tipe = item.tipe === 'frame' ? 'Frame' : item.tipe === 'lensa_l' ? 'Lensa L' : 'Lensa R';
      lines.push(tipe + ': ' + (item.nama_barang||'-'));
      var sub = ((item.harga||0) - (item.diskon||0)) * (item.jumlah||1);
      lines.push('  ' + fmtRp(item.harga) + (item.diskon > 0 ? ' disc ' + fmtRp(item.diskon) : '') + ' x' + item.jumlah + ' = ' + fmtRp(sub));
    });
    lines.push('--------------------------------');
    lines.push('Subtotal: ' + fmtRp(d.subtotal));
    if (d.biaya > 0) lines.push('Biaya   : ' + fmtRp(d.biaya));
    if (d.bpjs) lines.push('BPJS    : ' + d.bpjs);
    lines.push('TOTAL   : ' + fmtRp(d.total));
    lines.push('================================');
    lines.push('       Terima Kasih!');

    var w = window.open('','_blank','width=400,height=600');
    w.document.write('<html><head><title>Nota ' + d.no_nota + '</title><style>body{font-family:monospace;font-size:12px;white-space:pre;margin:20px}@media print{body{margin:0}}</style></head><body>' + lines.join('\n') + '</body></html>');
    w.document.close();
    w.onload = function() { w.print(); };
  });
}

function fmtRp(v) { return 'Rp ' + Number(v||0).toLocaleString('id-ID'); }

var voidId = null;
function confirmVoid(id) { voidId = id; new bootstrap.Modal('#voidModal').show(); }
$('#voidBtn').on('click', function() {
  if (!voidId) return;
  $.ajax({ url: '/penjualan/' + voidId, method: 'DELETE',
    success: function() { location.reload(); },
    error: function(xhr) { showToast(xhr.responseJSON?.message || 'Gagal', 'danger'); }
  });
});
</script>

<%- include('../partials/bottom') %>
