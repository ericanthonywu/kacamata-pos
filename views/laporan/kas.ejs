<% function fmtRp(v) { return 'Rp ' + Number(v||0).toLocaleString('id-ID'); } function fmtDate(d) { return d ? new
  Date(d).toLocaleDateString('id-ID') : '-' ; } %>
  <%- include('../partials/top', { title, activePage }) %>

    <div class="row g-2 mb-3 align-items-end">
      <div class="col-auto">
        <label class="form-label small">Dari</label>
        <input type="date" id="filterFrom" class="form-control form-control-sm" value="<%= filters.from || '' %>">
      </div>
      <div class="col-auto">
        <label class="form-label small">Sampai</label>
        <input type="date" id="filterTo" class="form-control form-control-sm" value="<%= filters.to || '' %>">
      </div>
      <div class="col-auto">
        <label class="form-label small">Sales</label>
        <select id="filterSales" class="form-select form-select-sm">
          <option value="">Semua</option>
          <% salesList.forEach(function(s) { %>
            <option value="<%= s.id %>" <%=String(filters.sales_id)===String(s.id) ? 'selected' : '' %>><%= s.nama %>
            </option>
            <% }); %>
        </select>
      </div>
      <div class="col-auto">
        <label class="form-label small">Kategori</label>
        <select id="filterKategori" class="form-select form-select-sm">
          <option value="">Semua</option>
          <% kategoriList.forEach(function(k) { %>
            <option value="<%= k.id %>" <%=String(filters.kategori_id)===String(k.id) ? 'selected' : '' %>><%= k.nama %>
            </option>
            <% }); %>
              <option value="both" <%=filters.kategori_id==='both' ? 'selected' : '' %>>Frame + Lensa</option>
        </select>
      </div>
      <div class="col-auto">
        <label class="form-label small">Status</label>
        <select id="filterStatus" class="form-select form-select-sm">
          <option value="">Semua</option>
          <option value="lunas" <%=filters.status_bayar==='lunas' ? 'selected' : '' %>>Lunas</option>
          <option value="dp" <%=filters.status_bayar==='dp' ? 'selected' : '' %>>DP (Belum Lunas)</option>
        </select>
      </div>
      <div class="col-auto">
        <button type="button" class="btn btn-primary btn-sm" onclick="reloadKas()"><i class="bi bi-search"></i>
          Tampilkan</button>
        <button type="button" class="btn btn-outline-danger btn-sm" onclick="resetFilter()"><i
            class="bi bi-x-circle"></i> Reset</button>
      </div>
    </div>

    <div class="row g-3 mb-4 row-cols-2 row-cols-md-5">
      <div class="col">
        <div class="stat-card"><i class="bi bi-receipt stat-icon text-info"></i>
          <div class="stat-value">
            <%= summary.total_transaksi %>
          </div>
          <div class="stat-label">Transaksi</div>
        </div>
      </div>
      <div class="col">
        <div class="stat-card"><i class="bi bi-shield-plus stat-icon text-secondary"></i>
          <div class="stat-value">
            <%= fmtRp(summary.total_bpjs) %>
          </div>
          <div class="stat-label">Total BPJS</div>
        </div>
      </div>
      <% if (currentUser.hak_akses==='admin' ) { %>
        <div class="col">
          <div class="stat-card"><i class="bi bi-cash stat-icon text-primary"></i>
            <div class="stat-value">
              <%= fmtRp(summary.total_subtotal) %>
            </div>
            <div class="stat-label">Total Keseluruhan</div>
          </div>
        </div>
        <div class="col">
          <div class="stat-card"><i class="bi bi-wallet2 stat-icon text-warning"></i>
            <div class="stat-value">
              <%= fmtRp(summary.total_pelunasan) %>
            </div>
            <div class="stat-label">Total Pelunasan Hutang</div>
          </div>
        </div>
        <div class="col">
          <div class="stat-card"><i class="bi bi-graph-up stat-icon text-success"></i>
            <div class="stat-value text-primary">
              <%= fmtRp(summary.total_penjualan) %>
            </div>
            <div class="stat-label">Uang Masuk</div>
          </div>
        </div>
        <% } %>
    </div>

    <div class="card p-3">
      <table id="tblKas" class="table table-hover mb-0" style="width:100%">
        <thead>
          <tr>
            <th>No. Nota</th>
            <th>Tanggal</th>
            <th>Pelanggan</th>
            <th>Sales</th>
            <th>Total</th>
            <th>DP</th>
            <th>BPJS</th>
            <% if (currentUser.hak_akses === 'admin') { %>
            <th>Uang Masuk</th>
            <% } %>
            <th>Sisa</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>

    <div class="modal fade" id="detailModal" tabindex="-1">
      <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Detail Penjualan</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body" id="detailBody">
            <div class="text-center">
              <div class="spinner-border text-primary" role="status"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      $(function () {
        function newExportAction(e, dt, button, config) {
          var self = this;
          var oldStart = dt.settings()[0]._iDisplayStart;
          dt.one('preXhr', function (e, s, data) {
            data.start = 0;
            data.length = -1;
            dt.one('preDraw', function (e, settings) {
              if (button[0].className.indexOf('buttons-excel') >= 0) {
                $.fn.dataTable.ext.buttons.excelHtml5.available(dt, config) ?
                  $.fn.dataTable.ext.buttons.excelHtml5.action.call(self, e, dt, button, config) : null;
              } else if (button[0].className.indexOf('buttons-csv') >= 0) {
                $.fn.dataTable.ext.buttons.csvHtml5.available(dt, config) ?
                  $.fn.dataTable.ext.buttons.csvHtml5.action.call(self, e, dt, button, config) : null;
              } else if (button[0].className.indexOf('buttons-print') >= 0) {
                $.fn.dataTable.ext.buttons.print.action.call(self, e, dt, button, config);
              }
              dt.one('preXhr', function (e, s, data) {
                settings._iDisplayStart = oldStart;
                data.start = oldStart;
              });
              setTimeout(dt.ajax.reload, 0);
              return false;
            });
          });
          dt.ajax.reload();
        }

        var isAdmin = <%= currentUser.hak_akses === 'admin' ? 'true' : 'false' %>;
        var exportCols = isAdmin ? [0, 1, 2, 3, 4, 5, 6, 7, 8] : [0, 1, 2, 3, 4, 5, 6, 7];

        var dtColumns = [
            {
              data: 'no_nota',
              render: function (data) { return '<span class="font-monospace text-info">' + escapeHtml(data) + '</span>'; }
            },
            {
              data: 'order_date',
              render: function (data) { return data ? new Date(data).toLocaleDateString('id-ID') : '-'; }
            },
            {
              data: 'pelanggan_nama',
              render: function (data) { return escapeHtml(data || '-'); }
            },
            {
              data: 'sales_nama',
              render: function (data) { return escapeHtml(data || '-'); }
            },
            {
              data: 'subtotal',
              render: function (data) { return fmtRp(data); }
            },
            {
              data: 'dp',
              render: function (data) { return parseFloat(data) > 0 ? fmtRp(data) : '-'; }
            },
            {
              data: 'bpjs',
              render: function (data) { return parseFloat(data) > 0 ? fmtRp(data) : '-'; }
            }
        ];

        if (isAdmin) {
            dtColumns.push({
              data: null,
              render: function (data, type, row) {
                var dp = parseFloat(row.dp || 0);
                var total = parseFloat(row.total || 0);
                var uangMasuk = row.status_bayar === 'dp' ? dp : total;
                return '<span class="fw-bold text-success">' + fmtRp(uangMasuk) + '</span>';
              }
            });
        }

        dtColumns.push({
            data: null,
            orderable: false,
            render: function (data, type, row) {
              var sisa = row.status_bayar === 'lunas' ? 0 : (parseFloat(row.subtotal) - parseFloat(row.dp || 0) - parseFloat(row.bpjs || 0));
              var cls = sisa === 0 ? 'text-success' : 'text-danger';
              return '<span class="fw-bold ' + cls + '">' + fmtRp(sisa) + '</span>';
            }
        });

        dtColumns.push({
            data: null,
            orderable: false,
            render: function (data, type, row) {
              return '<button class="btn btn-sm btn-outline-info" onclick="showDetail(' + row.id + ')" title="Detail"><i class="bi bi-eye"></i></button>';
            }
        });

        $('#tblKas').DataTable({
          serverSide: true,
          processing: true,
          ajax: {
            url: '/laporan/kas/dt',
            data: function (d) {
              d.from = $('#filterFrom').val();
              d.to = $('#filterTo').val();
              d.sales_id = $('#filterSales').val();
              d.kategori_id = $('#filterKategori').val();
              d.status_bayar = $('#filterStatus').val();
            }
          },
          order: [[1, 'desc']],
          lengthMenu: [[10, 50, 100, -1], [10, 50, 100, "All"]],
          layout: {
            topStart: {
              pageLength: {},
              buttons: {}
            },
            topEnd: 'search',
            bottomStart: 'info',
            bottomEnd: 'paging'
          },
          buttons: [
            {
              extend: 'excelHtml5',
              text: '<i class="bi bi-file-earmark-excel"></i> Excel',
              className: 'btn btn-success btn-sm',
              action: newExportAction,
              exportOptions: { columns: exportCols, orthogonal: 'export' }
            },
            {
              extend: 'csvHtml5',
              text: '<i class="bi bi-filetype-csv"></i> CSV',
              className: 'btn btn-info btn-sm',
              action: newExportAction,
              exportOptions: { columns: exportCols, orthogonal: 'export' }
            },
            {
              extend: 'print',
              text: '<i class="bi bi-printer"></i> Print',
              className: 'btn btn-secondary btn-sm',
              exportOptions: { columns: exportCols, orthogonal: 'export' }
            }
          ],
          columns: dtColumns,
          language: dtLanguageID
        });
      });

      function reloadKas() {
        // Also reload summary by navigating with filters
        var params = new URLSearchParams();
        if ($('#filterFrom').val()) params.set('from', $('#filterFrom').val());
        if ($('#filterTo').val()) params.set('to', $('#filterTo').val());
        if ($('#filterSales').val()) params.set('sales_id', $('#filterSales').val());
        if ($('#filterKategori').val()) params.set('kategori_id', $('#filterKategori').val());
        if ($('#filterStatus').val()) params.set('status_bayar', $('#filterStatus').val());
        window.location.href = '/laporan/kas?' + params.toString();
      }

      function resetFilter() {
        window.location.href = '/laporan/kas';
      }

      function fmtRp(v) { return 'Rp ' + Number(v || 0).toLocaleString('id-ID'); }

      function showDetail(id) {
        var myModal = new bootstrap.Modal(document.getElementById('detailModal'));
        myModal.show();
        $('#detailBody').html('<div class="text-center"><div class="spinner-border text-primary" role="status"></div></div>');

        $.get('/penjualan/' + id, function (res) {
          if (!res.success) {
            $('#detailBody').html('<div class="alert alert-danger">Gagal memuat detail.</div>');
            return;
          }
          var d = res.data;
          var html = '<table class="table table-sm table-bordered"><thead><tr><th>Barang</th><th>Kategori</th><th>Qty</th><th>Harga</th><th>Subtotal</th></tr></thead><tbody>';
          d.detail.forEach(function (item) {
            var itemName = item.nama_barang || item.keterangan || '-';
            html += '<tr>';
            html += '<td>' + itemName + '</td>';
            html += '<td>' + (item.kategori_nama || '-') + '</td>';
            html += '<td>' + (item.jumlah || 0) + '</td>';
            html += '<td>' + fmtRp(item.harga) + '</td>';
            html += '<td>' + fmtRp((item.harga || 0) * (item.jumlah || 0)) + '</td>';
            html += '</tr>';
          });
          html += '</tbody></table>';
          $('#detailBody').html(html);
        }).fail(function () {
          $('#detailBody').html('<div class="alert alert-danger">Terjadi kesalahan.</div>');
        });
      }
    </script>

    <%- include('../partials/bottom') %>