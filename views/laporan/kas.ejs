<%
function fmtRp(v) { return 'Rp ' + Number(v||0).toLocaleString('id-ID'); }
function fmtDate(d) { return d ? new Date(d).toLocaleDateString('id-ID') : '-'; }
%>
<%- include('../partials/top', { title, activePage }) %>

<form class="row g-2 mb-3 align-items-end" method="GET" action="/laporan/kas">
  <div class="col-auto">
    <label class="form-label small">Dari</label>
    <input type="date" name="from" class="form-control form-control-sm" value="<%= filters.from || '' %>">
  </div>
  <div class="col-auto">
    <label class="form-label small">Sampai</label>
    <input type="date" name="to" class="form-control form-control-sm" value="<%= filters.to || '' %>">
  </div>
  <div class="col-auto">
    <label class="form-label small">Sales</label>
    <select name="sales_id" class="form-select form-select-sm">
      <option value="">Semua</option>
      <% salesList.forEach(function(s) { %>
      <option value="<%= s.id %>" <%= String(filters.sales_id) === String(s.id) ? 'selected' : '' %>><%= s.nama %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-auto"><button type="submit" class="btn btn-primary btn-sm">Tampilkan</button></div>
</form>

<div class="row g-3 mb-4">
  <div class="col-md-3 col-6">
    <div class="stat-card"><i class="bi bi-receipt stat-icon text-info"></i><div class="stat-value"><%= summary.total_transaksi %></div><div class="stat-label">Transaksi</div></div>
  </div>
  <div class="col-md-3 col-6">
    <div class="stat-card"><i class="bi bi-cash stat-icon text-primary"></i><div class="stat-value"><%= fmtRp(summary.total_subtotal) %></div><div class="stat-label">Subtotal</div></div>
  </div>
  <div class="col-md-3 col-6">
    <div class="stat-card"><i class="bi bi-cash-coin stat-icon text-warning"></i><div class="stat-value"><%= fmtRp(summary.total_biaya) %></div><div class="stat-label">Biaya</div></div>
  </div>
  <div class="col-md-3 col-6">
    <div class="stat-card"><i class="bi bi-graph-up stat-icon text-success"></i><div class="stat-value"><%= fmtRp(summary.total_penjualan) %></div><div class="stat-label">Total Penjualan</div></div>
  </div>
</div>

<div class="card p-3">
  <table id="tblKas" class="table table-hover mb-0" style="width:100%">
    <thead>
      <tr><th>No. Nota</th><th>Tanggal</th><th>Pelanggan</th><th>Sales</th><th>Subtotal</th><th>Biaya</th><th>BPJS</th><th>Total</th></tr>
    </thead>
    <tbody>
      <% transactions.forEach(function(t) { %>
      <tr>
        <td class="font-monospace text-info"><%= t.no_nota %></td>
        <td><%= fmtDate(t.order_date) %></td>
        <td><%= t.pelanggan_nama || '-' %></td>
        <td><%= t.sales_nama || '-' %></td>
        <td><%= fmtRp(t.subtotal) %></td>
        <td><%= fmtRp(t.biaya) %></td>
        <td><%= t.bpjs || '-' %></td>
        <td class="fw-bold"><%= fmtRp(t.total) %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<script>
$(function() {
  $('#tblKas').DataTable({
    order: [],
    language: { url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/id.json' }
  });
});
</script>

<%- include('../partials/bottom') %>
